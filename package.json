{
  "name": "vs-code-flowers",
  "displayName": "VS Code Flowers",
  "description": "A calm little pixel-art flower garden inside VS Code.",
  "version": "0.1.0",
  "publisher": "PotRoast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobbybrady/vs-code-flowers.git"
  },
  "bugs": {
    "url": "https://github.com/bobbybrady/vs-code-flowers/issues"
  },
  "homepage": "https://github.com/bobbybrady/vs-code-flowers#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "garden",
    "flowers",
    "pixel art",
    "ambient",
    "relax",
    "succulent",
    "plants",
    "cozy"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#9ed3ea",
    "theme": "light"
  },
  "activationEvents": [
    "onView:vsCodeFlowers.gardenExplorer",
    "onView:vsCodeFlowers.garden",
    "onView:vsCodeFlowers.gardenBar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsCodeFlowersBar",
          "title": "Flowers",
          "icon": "media/flowers.svg"
        }
      ],
      "panel": [
        {
          "id": "vsCodeFlowers",
          "title": "Flowers",
          "icon": "media/flowers.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "vsCodeFlowers.gardenExplorer",
          "name": "VS Code Flowers"
        }
      ],
      "vsCodeFlowersBar": [
        {
          "type": "webview",
          "id": "vsCodeFlowers.gardenBar",
          "name": "Garden"
        }
      ],
      "vsCodeFlowers": [
        {
          "type": "webview",
          "id": "vsCodeFlowers.garden",
          "name": "Garden"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
